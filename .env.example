# ProMovies Environment Configuration
# Optional: Get your free API key at https://www.themoviedb.org/settings/api
# If left empty, ProMovies uses its built-in realistic high-definition catalog & failover proxies!
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Automated 6-Hour Content Sync & Cron
CRON_SECRET=your_secure_cron_secret_here
SYNC_INTERVAL_HOURS=6
RUN_ON_STARTUP=true

# Notification Webhooks (Discord, Email, Telegram)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database Connection (PostgreSQL / MySQL / SQLite via Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/promovies

